rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }



    function isAuthorizedUser() {
      return isAuthenticated() && getUserProfile().isAuthorized == true;
    }

    function isAdminUser() {
      return isAuthenticated() && getUserProfile().isAdmin == true;
    }

    function isUserShipmentOwner() {
      return isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sender.email == request.auth.token.email
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdminUser());

      // Self-registration can never grant privileges.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.isAuthorized == false;

      // Users may edit their own profile but never their own privilege flags.
      allow update: if isAdminUser() || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.isAuthorized == resource.data.isAuthorized
      );

      allow delete: if isAdminUser();
    }

    match /shipments/{shipmentId} {
      allow read: if true;

      allow create: if isAdminUser() || (isAuthorizedUser() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.sender.email == request.auth.token.email
      ));

      allow update, delete: if isAdminUser() || (isAuthorizedUser() && isUserShipmentOwner());

      match /events/{eventId} {
        allow read: if true;

        allow create: if isAdminUser() || (isAuthorizedUser() && isUserShipmentOwner());
        allow update, delete: if isAdminUser();
      }
    }
  }
}
